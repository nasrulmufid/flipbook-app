PORT=3001
# Akun admin awal (hanya dipakai saat tabel users masih kosong)
ADMIN_USER=admin
ADMIN_PASSWORD=ganti-dengan-password-yang-kuat
# Port host yang dipetakan ke aplikasi (Compose)
APP_PORT=3001
# Opsional: rahasia JWT (jika kosong dibuat otomatis di data/.jwt_secret)
# JWT_SECRET=
# Set true bila disajikan lewat HTTPS agar cookie login bertanda Secure
# COOKIE_SECURE=true
